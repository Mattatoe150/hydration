{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hydration",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": ".",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
